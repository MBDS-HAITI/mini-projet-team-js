# Backend Environment Variables for Production

# Server Configuration
NODE_ENV=production
PORT=7010

# Database - Use MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/school_db?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-secure-random-secret-key-minimum-32-characters
JWT_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-secure-session-secret-minimum-32-characters

# Redis Configuration - Use production Redis service (Upstash, Redis Cloud, etc.)
REDIS_URL=redis://username:password@host:port

# CORS Configuration - Use your Vercel frontend URL
CORS_ORIGIN=https://your-app.vercel.app

# URLs
BACKEND_URL=https://your-backend.onrender.com
FRONTEND_URL=https://your-app.vercel.app

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/oauth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=https://your-backend.onrender.com/api/oauth/github/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=https://your-backend.onrender.com/api/oauth/linkedin/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_CALLBACK_URL=https://your-backend.onrender.com/api/oauth/facebook/callback

# Email Configuration (Optional - for nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@school.com
