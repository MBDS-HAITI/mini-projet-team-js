# Frontend Environment Variables

# API Base URL - Backend API endpoint
# Development: http://localhost:7010
# Production: Your Render backend URL (e.g., https://school-backend.onrender.com)
VITE_API_URL=http://localhost:7010

# Optional: Google Client ID for OAuth (if needed in frontend)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id
